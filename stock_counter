SELECT * FROM (
    WITH stock_buy_summary AS (
        -- Calculate total buy amount for each stock
        SELECT 
            STOCK_CODE,
            STOCK_NAME,
            SUM(AMOUNT * PRICE) AS total_buy_amount
        FROM T_DEAL
        WHERE TRUNC(DEAL_TIME) = TRUNC(SYSDATE)  -- Today
          AND ENTRUST_DIRECTION = 2  -- 2 means buy
        GROUP BY STOCK_CODE, STOCK_NAME
    ),
    user_stock_buy AS (
        -- Calculate buy amount and average price for each user per stock
        SELECT 
            d.STOCK_CODE,
            d.STOCK_NAME,
            d.USERID,
            u.NAME,
            u.TEL,
            u.ID AS USER_ID,
            SUM(d.AMOUNT * d.PRICE) AS user_buy_amount,
            ROUND(AVG(d.PRICE), 2) AS user_avg_buy_price,
            ROW_NUMBER() OVER (PARTITION BY d.STOCK_CODE ORDER BY SUM(d.AMOUNT * d.PRICE) DESC) AS rn
        FROM T_DEAL d
        JOIN T_USER u ON u.ID = d.USERID
        WHERE TRUNC(d.DEAL_TIME) = TRUNC(SYSDATE)  -- Today
          AND d.ENTRUST_DIRECTION = 2  -- 2 means buy
        GROUP BY d.STOCK_CODE, d.STOCK_NAME, d.USERID, u.NAME, u.TEL, u.ID
    ),
    top_stocks AS (
        -- Select top 100 stocks by buy amount
        SELECT 
            STOCK_CODE,
            STOCK_NAME,
            total_buy_amount,
            ROW_NUMBER() OVER (ORDER BY total_buy_amount DESC) AS stock_rank
        FROM stock_buy_summary
    )
    SELECT 
        ts.stock_rank AS rank,
        ts.STOCK_CODE AS stock_code,
        ts.STOCK_NAME AS stock_name,
        ts.total_buy_amount AS stock_total_buy_amount,
        usb.USER_ID AS top_buyer_user_id,
        usb.NAME AS top_buyer_name,
        usb.TEL AS top_buyer_tel,
        usb.user_buy_amount AS top_buyer_amount,
        usb.user_avg_buy_price AS top_buyer_avg_price
    FROM top_stocks ts
    JOIN user_stock_buy usb ON ts.STOCK_CODE = usb.STOCK_CODE AND usb.rn = 1
    WHERE ts.stock_rank <= 100
    ORDER BY ts.total_buy_amount DESC
);
